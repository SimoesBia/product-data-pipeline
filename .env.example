# Copie para .env e ajuste. Variáveis de ambiente reais têm prioridade sobre este arquivo.

# Banco de dados (SQLite)
DATABASE_PATH=data/products.db

# Scraper
SCRAPER_BASE_URL=http://books.toscrape.com/
SCRAPER_MAX_PAGES=50            # 0 = seguir a paginação até o fim
SCRAPER_DELAY_SECONDS=0.5       # pausa entre páginas (boa educação com o servidor)
SCRAPER_TIMEOUT_SECONDS=10
# SCRAPER_USER_AGENT=product-data-pipeline/1.0 (+https://github.com/SimoesBia/product-data-pipeline)

# API
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
